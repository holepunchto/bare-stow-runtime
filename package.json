{
  "name": "bare-stow-runtime",
  "version": "0.0.0",
  "description": "Bundle side of the bare-stow lifecycle",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./process": {
      "types": "./process.d.ts",
      "default": "./process.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "process.js",
    "process.d.ts"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:bare && npm run test:node",
    "test:bare": "brittle-bare --coverage test.js",
    "test:node": "brittle-node --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-stow-runtime.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-stow-runtime/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-stow-runtime#readme",
  "dependencies": {
    "bare-signals": "^5.0.0",
    "bare-stow-protocol": "^0.1.0",
    "bare-stream": "^2.13.1"
  },
  "devDependencies": {
    "bare-sidecar": "^0.5.12",
    "bare-stow-host": "^0.1.0",
    "brittle": "^4.0.2",
    "lunte": "^1.7.0",
    "prettier": "^3.3.3",
    "prettier-config-holepunch": "^2.0.0"
  }
}
